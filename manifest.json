{
  "manifest_version": 3,
  "name": "Chat to Markdown for Claude",
  "short_name": "Chat to Markdown",
  "version": "1.2.1",
  "description": "Save the open claude.ai conversation as a clean Markdown file. Runs only when you click; nothing leaves your browser.",
  "permissions": ["activeTab", "scripting"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export this chat as Markdown",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
